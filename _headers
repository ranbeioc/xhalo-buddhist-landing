/*
  Cache-Control: public, no-transform
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https://*.clarity.ms https://c.bing.com; style-src 'self'; script-src 'self' 'sha256-EZ+dV5GhS+s20jmrYPm/8566m68osxLmsDgMIJBDyKE=' 'sha256-8JQFF+c99ZuGKZVyhrHmjKeNY9O5CnjBey++rsFJj+A=' 'sha256-44lZoanpjdPzaz0w6KHpC20EjxMv0TTzr6+yOzyLTVE=' 'sha256-koUU8vvewSSg/XPLJy2A9d+ISYTp3557fcUTvGZD0a0=' https://www.clarity.ms https://scripts.clarity.ms; font-src 'self'; connect-src 'self' https://buddb.xhalo.co https://foread.xhalo.co https://*.clarity.ms; manifest-src 'self'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Revalidate rather than hold for a day. The ?v= query parameter these files are linked with in
# index.html does NOT bust Cloudflare's edge cache -- the cache key here ignores the query string,
# so /app.js?v=NEW returned cf-cache-status: HIT with the previous file. Combined with a 24h
# max-age that meant a shipped fix could stay invisible to visitors for a full day, which is
# exactly what happened to a hero-performance fix on 2026-09-12. These files are small (app.js
# ~15KB, css ~32KB) so revalidating costs a 304 round trip and keeps deploys actually deployable.
/*.css
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate
